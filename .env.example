# Образец переменных окружения.
# Скопируйте в файл .env и подставьте свои значения:
#   cp .env.example .env
#
# ! .env никогда не попадает в git (см. .gitignore). Пароли реальной БД
#   храните только в локальном .env, в репозиторий их не загружайте.

# Подключение к PostgreSQL (локально или внутри docker-compose)
DB_USER=postgres
DB_PASSWORD=your_strong_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=esoft_analytics_api

# Режим отладки Flask (True/False)
FLASK_DEBUG=False